#<----- 1.import libraries ----->
from rdkit import Chem
import pandas as pd
from rdkit.Chem import Draw
from rdkit import DataStructs
from rdkit.Chem import Descriptors

#<-------2. Load Dataset------->
file=input("enter csv file name: ")
df=pd.read_csv(file)
'''input_smiles=input("enter your smiles: ")
